@model IEnumerable<RaceDayMVC.Models.EventDto>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mt-4">
    <h2>My Events</h2>
    <a asp-action="Create" class="btn btn-primary">+ Create New Event</a>
</div>

<div class="card mt-4 shadow-sm">
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted">You haven't created any events yet.</p>
        }
        else
        {
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Banner</th>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(ev.ImageUrl))
                                {
                                    <img src="@ev.ImageUrl" alt="Banner" style="width: 80px; height: 50px; object-fit: cover; border-radius: 5px;" />
                                }
                                else
                                {
                                    <span class="text-muted">No Image</span>
                                }
                            </td>
                            <td>@ev.Name</td>
                            <td>@ev.Date.ToShortDateString()</td>
                            <td>@ev.Location</td>
                            <td>@ev.EventType</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@ev.Id" class="btn btn-sm btn-primary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@ev.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>