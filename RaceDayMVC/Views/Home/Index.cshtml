@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to RaceDay!</h1>

    @if (Context.Session.GetString("UserRole") != null)
    {
        <div class="alert alert-success mt-4">
            <h4>You are logged in as: <strong>@Context.Session.GetString("UserRole")</strong></h4>
            <p>User ID: @Context.Session.GetString("UserId")</p>
            <a href="/Account/Logout" class="btn btn-danger mt-2">Logout</a>
        </div>
    }
    else
    {
        <p>You are not logged in. <a href="/Account/Login">Click here to login</a>.</p>
    }
</div>